SCOUT_PORT=10009
SCOUT_JWT_SECRET=<CHANGE-ME-strong-random-secret>
SCOUT_DB_PATH=data/scout.db
SCOUT_CORS_ORIGINS=https://<CHANGE-ME-domain>

# Optional: enable Scout's own dashboard widget and report into this project slug
# SCOUT_DASHBOARD_WIDGET_PROJECT_SLUG=scout

# Optional Grafana links
# Must be reachable by dashboard users. For passwordless links, configure Grafana/proxy
# anonymous Viewer access on this host; do not put credentials in the URL.
# SCOUT_GRAFANA_URL=https://<CHANGE-ME-grafana-domain>
# Optional same-origin Scout-authenticated proxy target for /grafana/...
# SCOUT_GRAFANA_PROXY_TARGET=http://<CHANGE-ME-internal-grafana-host>:3000
# SCOUT_GRAFANA_PROXY_STRIP_PREFIX=false

# Optional runtime error group housekeeping
# Days without a new occurrence before an active group resolves itself; 0 keeps every group open
# SCOUT_ERROR_AUTO_RESOLVE_DAYS=7
# SCOUT_ERROR_MAINTENANCE_INTERVAL_MS=3600000

# Optional email delivery
# SMTP_HOST=<CHANGE-ME-smtp-host>
# SMTP_PORT=587
# SMTP_USER=<CHANGE-ME-smtp-user>
# SMTP_PASS=<CHANGE-ME-smtp-password>
# SMTP_FROM=<CHANGE-ME-from-address>
# SMTP_SECURE=false
# SCOUT_PUBLIC_URL=https://<CHANGE-ME-domain>
# SCOUT_DAILY_DIGEST_ENABLED=true
# SCOUT_DAILY_DIGEST_TIME=18:00
# SCOUT_DAILY_DIGEST_TIMEZONE=Asia/Almaty

LOG_LEVEL=info
